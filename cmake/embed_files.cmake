include_guard(GLOBAL)
# bam_embed_files(<dir> <output.cpp> <header> <namespace> <struct> <table> <count>)
# Embeds every file in <dir>/ (relative to the source tree) into a C++ source defining
# `const <struct> <table>[]` and `const size_t <count>` in <namespace>. Re-runs when a file changes.
function(bam_embed_files dir output header ns struct table count)
  file(GLOB _files CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/${dir}/*)
  set(_out "// Generated from ${dir}/ by cmake/embed_files.cmake. Do not edit.\n#include \"${header}\"\n\nnamespace ${ns} {\nnamespace {\n")
  set(_table "")
  set(_index 0)
  foreach(_file ${_files})
    get_filename_component(_name ${_file} NAME)
    get_filename_component(_ext ${_file} EXT)
    string(TOLOWER "${_ext}" _ext)
    set(_mime "application/octet-stream")
    if(_ext STREQUAL ".html")
      set(_mime "text/html; charset=utf-8")
    elseif(_ext STREQUAL ".js")
      set(_mime "text/javascript; charset=utf-8")
    elseif(_ext STREQUAL ".css")
      set(_mime "text/css; charset=utf-8")
    elseif(_ext STREQUAL ".svg")
      set(_mime "image/svg+xml")
    elseif(_ext STREQUAL ".png")
      set(_mime "image/png")
    elseif(_ext STREQUAL ".ico")
      set(_mime "image/x-icon")
    endif()
    file(READ ${_file} _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _out "const unsigned char asset_${_index}[] = {${_bytes}0x00};\n")
    string(APPEND _table "    {\"/${_name}\", \"${_mime}\", asset_${_index}, ${_size}},\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_file})
    math(EXPR _index "${_index} + 1")
  endforeach()
  string(APPEND _out "}  // namespace\n\nconst ${struct} ${table}[] = {\n${_table}    {nullptr, nullptr, nullptr, 0}};\nconst size_t ${count} = ${_index};\n\n}  // namespace ${ns}\n")
  file(WRITE ${output}.tmp "${_out}")
  configure_file(${output}.tmp ${output} COPYONLY)  # touch only when changed
endfunction()

# BounceAES Master panel: panel/ -> bam::kPanelAssets
set(BAM_PANEL_ASSETS_CPP ${CMAKE_CURRENT_BINARY_DIR}/panel_assets.cpp)
bam_embed_files(panel ${BAM_PANEL_ASSETS_CPP} "bam/http_server.hpp" bam PanelAsset kPanelAssets kPanelAssetCount)
