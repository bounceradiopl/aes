<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- WiX Toolset v5 package. Build: wix build BounceAES.wxs -arch x64 -d BinDir=<folder with binaries>
     -ext WixToolset.Util.wixext -ext WixToolset.Firewall.wixext -o BounceAES-Master-x64.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="BounceAES Master"
           Manufacturer="Bounce"
           Version="1.0.0"
           UpgradeCode="5C0E3B7A-2D41-4C8E-9F3B-6A1D7E2B9C40"
           Scope="perMachine"
           Language="1045"
           Codepage="1250">
    <SummaryInformation Description="BounceAES Master — sterownik ASIO AES67 (open source)" />
    <MajorUpgrade DowngradeErrorMessage="Zainstalowana jest nowsza wersja BounceAES Master." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="BounceIcon" SourceFile="..\tray\bounce.ico" />
    <Property Id="ARPPRODUCTICON" Value="BounceIcon" />
    <Launch Condition="VersionNT64" Message="BounceAES Master wymaga 64-bitowego systemu Windows 10 lub 11." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BounceAES Master" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="BounceAES Master" />
    </StandardDirectory>

    <Feature Id="Main" Title="BounceAES Master" Level="1">
      <ComponentGroupRef Id="Core" />
    </Feature>

    <ComponentGroup Id="Core" Directory="INSTALLFOLDER">

      <!-- Service: network, PTP, AES67 streams, web panel -->
      <Component Id="Service" Guid="9E4B1C7D-3A52-4F80-8B61-2C7D9E0A1B33">
        <File Id="ServiceExe" Source="$(var.BinDir)\BounceAESService.exe" KeyPath="yes" />
        <ServiceInstall Id="InstallService"
                        Name="BounceAESMaster"
                        DisplayName="BounceAES Master"
                        Description="Strumienie audio AES67, zegar PTP i panel WWW dla sterownika ASIO BounceAES Master."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ControlService" Name="BounceAESMaster" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <fire:FirewallException Id="ServiceFirewall" Name="BounceAES Master" Program="[#ServiceExe]" Scope="any" Profile="all" />
        <!-- Event Log source; message %1 comes from the .NET Framework message table present on every Windows 10/11 -->
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\BounceAES Master">
          <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
          <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
        </RegistryKey>
      </Component>

      <!-- ASIO driver: COM in-process server + ASIO driver list entry -->
      <Component Id="AsioDriver" Guid="2F6A8D1E-7B39-4C25-A4E0-5D3B8F1C6E72">
        <File Id="AsioDll" Source="$(var.BinDir)\BounceAESAsio.dll" KeyPath="yes" />
        <RegistryKey Root="HKCR" Key="CLSID\{6B1F3C2A-8E4D-4B7A-9C51-2A7E0D4B3F10}">
          <RegistryValue Type="string" Value="BounceAES Master ASIO Driver" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[#AsioDll]" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\ASIO\BounceAES Master">
          <RegistryValue Name="CLSID" Type="string" Value="{6B1F3C2A-8E4D-4B7A-9C51-2A7E0D4B3F10}" />
          <RegistryValue Name="Description" Type="string" Value="BounceAES Master" />
        </RegistryKey>
      </Component>

      <!-- Tray status application, started at logon -->
      <Component Id="Tray" Guid="B8C3E5F1-0D7A-4E96-8F24-7A1B3C9D5E06">
        <File Id="TrayExe" Source="$(var.BinDir)\BounceAESTray.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="BounceAES Master" Type="string" Value="&quot;[#TrayExe]&quot;" />
      </Component>

      <Component Id="Docs" Guid="4D9E2A6B-8C17-4F3D-B5E8-1A6C7F2D9B41">
        <File Id="License" Source="..\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        <File Id="InstallDoc" Source="..\docs\INSTALL.md" Name="INSTRUKCJA.md" />
      </Component>

      <Component Id="StartMenu" Directory="MenuFolder" Guid="E1A7C3D9-5B28-4F6E-9D04-3C8B2E7A1F95">
        <Shortcut Id="TrayShortcut" Name="BounceAES Master" Description="Stan i panel BounceAES Master" Target="[INSTALLFOLDER]BounceAESTray.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Bounce\BounceAES Master" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
