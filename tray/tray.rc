#include <windows.h>

1 ICON "bounce.ico"
2 ICON "status-ok.ico"
3 ICON "status-warn.ico"
4 ICON "status-down.ico"
#ifdef __GNUC__
// MinGW: embed the manifest here. MSVC gets it through the linker (tray.manifest listed as a source).
1 24 "tray.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,4,0
PRODUCTVERSION 1,2,4,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041504B0"
    BEGIN
      VALUE "CompanyName", "Bounce"
      VALUE "FileDescription", "BounceAES Master - zasobnik"
      VALUE "FileVersion", "1.2.4"
      VALUE "ProductName", "BounceAES Master"
      VALUE "ProductVersion", "1.2.4"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0415, 1200
  END
END
